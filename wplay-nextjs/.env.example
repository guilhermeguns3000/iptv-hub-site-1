# --- Backend próprio (KnewCMS, mcapi.knewcms.com) ---------------------------
# Token de produção do painel Warez/KnewCMS. Vale para todo o portfólio (mesma
# conta usada por WarezTV/Vizzion/Krator/appkplay) — cada teste gerado com ele
# consome cota real. NUNCA escrever o valor real em nenhum arquivo do repo.
WTV_IPTV_TOKEN=
# Base da API — só mudar se o KnewCMS trocar de host/porta.
WTV_IPTV_BASE=https://mcapi.knewcms.com:2087

# --- WhatsApp de suporte (DDI+DDD+número, só dígitos) ------------------------
NEXT_PUBLIC_WHATSAPP=5562993901860

# --- Flora Dashboard (hub de analytics/vendas do portfólio) -----------------
# Espelha 'test_started' pro funil do Flora. Não bloqueante — se ausente, o
# teste continua funcionando normalmente, só não aparece no painel.
FLORA_WEBHOOK_URL=

# --- Dedupe / rate limit (Upstash Redis) -------------------------------------
# Opcional: sem isso, o dedupe de teste por e-mail/telefone e o rate limit por
# IP ficam desativados (fail-open) — o site funciona, só sem essa proteção.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- SEO / URL canônica -------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://iptu2022br.com.br
